@model IEnumerable<TecnoGasHogar.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Listado de Solicitudes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-navy mb-0">Solicitudes de Servicio</h3>
        <p class="text-muted mb-0">Consulta de solicitudes registradas en el sistema</p>
    </div>
    <a asp-action="Registrar" class="btn btn-flame px-4 py-2 rounded-pill shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Nueva Solicitud
    </a>
</div>

<div class="card card-custom p-4 text-center">
    <p class="text-muted mb-0">Módulo de listado base habilitado.</p>
</div>
