@model IEnumerable<TecnoGasHogar.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Listado de Solicitudes de Servicio";
    var totalSolicitudes = Model.Count();
    var totalFugas = Model.Count(s => s.TipoServicio == "Fuga");
    var totalInstalaciones = Model.Count(s => s.TipoServicio == "Instalación");
    var totalMantenimiento = Model.Count(s => s.TipoServicio == "Mantenimiento");
    var totalRevision = Model.Count(s => s.TipoServicio == "Revisión");
}

<!-- Encabezado de Página -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-navy mb-1">
            <i class="bi bi-card-checklist text-flame me-2"></i>Portal de Solicitudes Técnicas
        </h2>
        <p class="text-muted mb-0">Control y seguimiento de pedidos de servicio de gas doméstico en tiempo real.</p>
    </div>
    <a asp-action="Registrar" class="btn btn-flame px-4 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-circle-fill"></i>
        <span>Nueva Solicitud</span>
    </a>
</div>

<!-- Tarjetas de Resumen / KPIs -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Pedidos</span>
                    <h3 class="fw-bold mb-0 text-navy mt-1">@totalSolicitudes</h3>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-clipboard-data fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Fugas (Urgente)</span>
                    <h3 class="fw-bold mb-0 text-danger mt-1">@totalFugas</h3>
                </div>
                <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                    <i class="bi bi-fire fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Instalaciones</span>
                    <h3 class="fw-bold mb-0 text-info mt-1">@totalInstalaciones</h3>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                    <i class="bi bi-wrench-adjustable fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Mant. / Revisión</span>
                    <h3 class="fw-bold mb-0 text-success mt-1">@(totalMantenimiento + totalRevision)</h3>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                    <i class="bi bi-check2-all fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla Principal de Solicitudes -->
<div class="card card-custom overflow-hidden">
    <div class="card-custom-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-table text-navy"></i>
            <h5 class="mb-0 fw-bold text-navy">Registros en Base de Datos (SQLite)</h5>
        </div>
        <span class="badge bg-navy text-white rounded-pill px-3 py-2">
            @totalSolicitudes @(totalSolicitudes == 1 ? "solicitud" : "solicitudes")
        </span>
    </div>

    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <!-- Estado Vacío -->
            <div class="text-center py-5 px-3">
                <div class="brand-badge mx-auto mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-inbox fs-2 text-flame"></i>
                </div>
                <h5 class="fw-bold text-navy">No hay solicitudes registradas todavía</h5>
                <p class="text-muted mb-4">Comienza registrando la primera solicitud de servicio técnico de gas.</p>
                <a asp-action="Registrar" class="btn btn-flame px-4 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Registrar Primera Solicitud
                </a>
            </div>
        }
        else
        {
            <!-- Tabla Responsiva -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4 py-3" style="width: 70px;"># ID</th>
                            <th class="py-3">Cliente</th>
                            <th class="py-3">Contacto</th>
                            <th class="py-3">Distrito</th>
                            <th class="py-3">Tipo de Servicio</th>
                            <th class="py-3">Descripción</th>
                            <th class="pe-4 py-3 text-end">Fecha de Registro</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-navy">
                                    <span class="badge bg-light text-dark border">#@item.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-light text-navy rounded-circle p-2 d-inline-flex">
                                            <i class="bi bi-person text-navy"></i>
                                        </div>
                                        <span class="fw-semibold text-dark">@item.Cliente</span>
                                    </div>
                                </td>
                                <td>
                                    <a href="tel:@item.Telefono" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-telephone-fill text-success small"></i>
                                        <span>@item.Telefono</span>
                                    </a>
                                </td>
                                <td>
                                    <span class="d-inline-flex align-items-center gap-1 text-muted">
                                        <i class="bi bi-geo-alt-fill text-danger small"></i>
                                        @item.Distrito
                                    </span>
                                </td>
                                <td>
                                    @switch (item.TipoServicio)
                                    {
                                        case "Fuga":
                                            <span class="badge-pill-custom badge-service-fuga">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Fuga (Urgente)
                                            </span>
                                            break;
                                        case "Instalación":
                                            <span class="badge-pill-custom badge-service-instalacion">
                                                <i class="bi bi-wrench-adjustable"></i> Instalación
                                            </span>
                                            break;
                                        case "Mantenimiento":
                                            <span class="badge-pill-custom badge-service-mantenimiento">
                                                <i class="bi bi-gear-fill"></i> Mantenimiento
                                            </span>
                                            break;
                                        case "Revisión":
                                            <span class="badge-pill-custom badge-service-revision">
                                                <i class="bi bi-search"></i> Revisión
                                            </span>
                                            break;
                                        default:
                                            <span class="badge-pill-custom bg-secondary text-white">
                                                @item.TipoServicio
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted" style="max-width: 260px;">
                                    @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                    {
                                        <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@item.Descripcion">
                                            @item.Descripcion
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Sin descripción</span>
                                    }
                                </td>
                                <td class="pe-4 text-end text-muted small">
                                    <div class="fw-semibold text-dark">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>@item.FechaRegistro.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-clock me-1"></i>@item.FechaRegistro.ToString("hh:mm tt")
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
