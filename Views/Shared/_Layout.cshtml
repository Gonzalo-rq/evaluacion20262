<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TecnoGas Hogar</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <!-- Navbar Corporativo -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-navy shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4" asp-area="" asp-controller="Solicitud" asp-action="Registrar">
                    <span class="brand-badge"><i class="bi bi-fire text-flame"></i></span>
                    <span>TecnoGas <span class="text-flame-light">Hogar</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1 gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-pill d-flex align-items-center gap-2 text-white" asp-controller="Solicitud" asp-action="Registrar">
                                <i class="bi bi-plus-circle-fill text-flame"></i>
                                <span>Nueva Solicitud</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-pill d-flex align-items-center gap-2 text-white-50" asp-controller="Solicitud" asp-action="Listado">
                                <i class="bi bi-card-checklist"></i>
                                <span>Ver Solicitudes</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido Principal -->
    <main role="main" class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer Corporativo -->
    <footer class="footer mt-auto py-3 bg-white border-top text-muted">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <small>&copy; @DateTime.Now.Year <strong>TecnoGas Hogar S.A.C.</strong> &bull; Sistema de Gestión de Solicitudes Técnicas</small>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="badge bg-light text-secondary border"><i class="bi bi-shield-check text-success me-1"></i> Prototipo de Validación v1.0</small>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
